<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    tools:context=".home">


    <androidx.core.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="00dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/jb_mart"
            android:paddingStart="20dp"
            android:background="@color/lavender"
            android:textSize="36sp"
            android:textColor="@color/yellow"
            android:textStyle="bold"
            android:textAlignment="viewStart"
            android:layout_marginTop="0dp"
            tools:ignore="RtlSymmetry" />

        <TextView
            android:id="@+id/searchview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/custom_edittext"
            android:layout_marginTop="00dp"
            android:drawableLeft="@drawable/baseline_search_24"
            android:padding="10dp"
            android:textSize="20sp"
            android:paddingStart="20dp"
            android:hint="@string/search"/>



        <HorizontalScrollView
            android:id="@+id/horizontalscrollview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/custom_edittext"
                android:id="@+id/beauty"
                android:src="@drawable/beauty"
                tools:ignore="ContentDescription"/>

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/custom_edittext"
                android:src="@drawable/women_f"
                android:layout_marginStart="8dp"
                android:id="@+id/woman_clothes"
                tools:ignore="ContentDescription" />

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/custom_edittext"
                android:src="@drawable/man_f"
                android:layout_marginStart="4dp"
                android:id="@+id/man_clothes"
                tools:ignore="ContentDescription"/>

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/custom_edittext"
                android:src="@drawable/mobile2"
                android:layout_marginStart="4dp"
                android:id="@+id/mobile"
                tools:ignore="ContentDescription"/>
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/custom_edittext"
                android:src="@drawable/laptop2"
                android:id="@+id/laptop"
                android:layout_marginStart="4dp"

                tools:ignore="ContentDescription"/>

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/custom_edittext"
                android:src="@drawable/watch1"
                android:layout_marginStart="4dp"
                android:id="@+id/watch"
                tools:ignore="ContentDescription"/>

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/custom_edittext"
                android:src="@drawable/grocery2"
                android:layout_marginStart="4dp"
                android:id="@+id/groceries"
                tools:ignore="ContentDescription"/>

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/custom_edittext"
                android:src="@drawable/electronics"
                android:layout_marginStart="4dp"
                android:id="@+id/electronics"
                tools:ignore="ContentDescription"/>

        </LinearLayout>
        </HorizontalScrollView>


        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerImageSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:layout_marginTop="6dp"
            android:paddingEnd="0dp">


        </androidx.viewpager2.widget.ViewPager2>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="vertical"
            tools:listitem="@layout/product_items_layout"
            android:layout_marginBottom="60dp"
            android:layout_marginTop="10dp" />






    </LinearLayout>

    </androidx.core.widget.NestedScrollView>



    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/container"
        android:layout_above="@id/bottomNavigationView"/>




    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/lavender"
        app:itemIconTint="@color/white"
        app:itemIconSize="30dp"
        app:menu="@menu/menu_bottom" />




</RelativeLayout>

